# OpenAI key for Sol and Astra. Set in Vercel AND Trigger.dev for each environment.
OPENAI_API_KEY=

# Admin chat: read-only Sanity Context + direct OpenAI/Anthropic streaming.
# Organization-level Context Viewer token, NOT a project read/write token.
# Enable only after npm run chat:check passes in the deployment environment.
ADMIN_CHAT_ENABLED=0
ADMIN_CHAT_INSIGHTS_ENABLED=0
# Separate organization Context Editor token for private transcripts and Insights.
SANITY_CONTEXT_WRITE_TOKEN=
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=

# Private Sanity connection (project quli96gc, dataset production).
# Server-only credentials. The editor token is required for app/worker writes.
# Never use a VITE_ or NEXT_PUBLIC_ prefix or commit this token.
SANITY_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_CONTENT_ENABLED=0
# Set after the matching worker deployment and storage probe pass.
SANITY_WORKERS_READY=0
# Branch preview deployments must target matching Trigger preview workers.
TRIGGER_PREVIEW_BRANCH=
# Explicit opt-in for a preview app targeting a locally running development worker.
SANITY_WORKER_ENV=preview

# Set to 1 in BOTH Vercel and Trigger.dev to use published Analysis settings.
# Enabled tasks fail closed if settings cannot be loaded; drafts never affect tasks.
SANITY_ANALYSIS_ENABLED=0

# Jev decisions directly through TypeSafe (jev-1.13.0). Set this in Vercel AND Trigger.dev.
# Jev is used automatically when the key is configured. Deploy jev-score first.
TYPESAFE_API_KEY=

# Minimum Jev fit score for NEW imported jobs (inclusive, 0–100). No flag.
# Existing jobs are refreshed without being removed or archived by screening.
JEV_INGEST_MIN_SCORE=60

# Your Anthropic API key — set this in the Vercel/Netlify dashboard, never commit it.
ANTHROPIC_API_KEY=sk-ant-...

# Redis credentials consumed by the current @vercel/kv adapter. Connect an
# Upstash Redis Marketplace integration and map its credentials to these names.
# Production refuses to start without them; memory storage is development-only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Same namespace in branch app/workers; omit for existing production behavior.
KV_NAMESPACE=

# Shared secret for /admin — set a long random value in the Vercel dashboard, never commit it.
ADMIN_SECRET=

# Trigger.dev environment key used by backend routes that start tasks.
# Use the dev key locally; the Vercel integration injects the correct key per environment.
TRIGGER_SECRET_KEY=
# Enable only after admin-context-chat is registered by a running Trigger Development worker.
# Use a tr_dev_ key, including in Vercel Preview, with the matching Development branch.
ADMIN_CHAT_WORKER_READY=0
# Chat-scoped overrides keep other app task connections unchanged.
ADMIN_CHAT_TRIGGER_SECRET_KEY=
ADMIN_CHAT_TRIGGER_BRANCH=codex/sanity-context-chat-setup

# Optional separate HMAC secret for public background-run receipts. If omitted,
# ADMIN_SECRET is used. Set PUBLIC_ANALYSIS_DISABLED=1 to pause new public work.
PUBLIC_RUN_SECRET=
PUBLIC_ANALYSIS_DISABLED=0

# Public admission defaults. Omit these variables to use 20k / 10 hourly / 60 daily.
PUBLIC_ANALYSIS_MAX_CHARS=20000
PUBLIC_ANALYSIS_IP_HOURLY_LIMIT=10
PUBLIC_ANALYSIS_DAILY_LIMIT=60

# Prompt caches default to five minutes. Use 1h only if usage shows repeated
# calls spaced 5–60 minutes apart; one-hour cache writes cost more.
AI_CACHE_TTL=5m

# Optional effort experiments for analyses and letters. Allowed: low, medium,
# high. Defaults preserve high effort; routine economy answers use medium.
AI_ANALYSE_EFFORT=high
AI_COVER_EFFORT=high

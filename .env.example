# Your Anthropic API key — set this in the Vercel/Netlify dashboard, never commit it.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel KV (added automatically when you create a KV store in the Vercel dashboard).
# If these are absent, the app falls back to in-memory storage (dev only — links won't persist).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shared secret for /admin — set a long random value in the Vercel dashboard, never commit it.
ADMIN_SECRET=

# Trigger.dev environment key used by backend routes that start tasks.
# Use the dev key locally; the Vercel integration injects the correct key per environment.
TRIGGER_SECRET_KEY=

# Optional separate HMAC secret for public background-run receipts. If omitted,
# ADMIN_SECRET is used. Set PUBLIC_ANALYSIS_DISABLED=1 to pause new public work.
PUBLIC_RUN_SECRET=
PUBLIC_ANALYSIS_DISABLED=0

# Public admission defaults. Omit these variables to use 20k / 10 hourly / 60 daily.
PUBLIC_ANALYSIS_MAX_CHARS=20000
PUBLIC_ANALYSIS_IP_HOURLY_LIMIT=10
PUBLIC_ANALYSIS_DAILY_LIMIT=60

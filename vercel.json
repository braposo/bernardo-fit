{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/admin/cv",
      "destination": "/api/admin/jobs?document=cv"
    },
    {
      "source": "/fit/:publicId/cv.pdf",
      "destination": "/api/site?page=application&publicId=:publicId&kind=pdf"
    },
    {
      "source": "/fit/:publicId",
      "destination": "/api/site?page=application&publicId=:publicId"
    },
    {
      "source": "/",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/index",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/index.html",
      "destination": "/api/site?page=home"
    },
    {
      "source": "/cv",
      "destination": "/api/site?page=cv"
    },
    {
      "source": "/cv.html",
      "destination": "/api/site?page=cv"
    },
    {
      "source": "/letter",
      "destination": "/api/site?page=letter"
    },
    {
      "source": "/letter.html",
      "destination": "/api/site?page=letter"
    },
    {
      "source": "/bernardo-raposo-cv.pdf",
      "destination": "/api/site?page=download"
    }
  ],
  "functions": {
    "api/admin/chat.js": {
      "maxDuration": 240
    },
    "api/site.js": {
      "includeFiles": "lib/{templates/*.html,assets/cv-fonts/*.ttf}"
    },
    "api/admin/jobs.js": {
      "includeFiles": "lib/assets/cv-fonts/*.ttf"
    }
  }
}

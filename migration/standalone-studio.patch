+++ b/schemaTypes/content.ts
@@ -0,0 +1,179 @@
+import {defineArrayMember, defineField, defineType} from 'sanity'
+import {DocumentTextIcon} from '@sanity/icons/DocumentText'
+import {UserIcon} from '@sanity/icons/User'
+import {LinkIcon} from '@sanity/icons/Link'
+import {extraFields, migrationFields, migrationRecord, replacements} from './migrationFields'
+
+const text = (name: string, title: string, required = false) => defineField({
+  name, title, type: 'text', rows: 4,
+  validation: (rule) => required ? rule.required() : rule,
+})
+const string = (name: string, title: string, required = false) => defineField({
+  name, title, type: 'string', validation: (rule) => required ? rule.required() : rule,
+})
+const date = (name: string, title: string) => defineField({name, title, type: 'datetime'})
+const ref = (name: string, title: string, type: string, required = false) => defineField({
+  name, title, type: 'reference', to: [{type}],
+  validation: (rule) => required ? rule.required() : rule,
+})
+const refs = (name: string, title: string, type: string) => defineField({
+  name, title, type: 'array', of: [defineArrayMember({type: 'reference', to: [{type}]})],
+  validation: (rule) => rule.unique(),
+})
+const body = (name = 'body', title = 'Content') => defineField({
+  name, title, type: 'array', of: [defineArrayMember({type: 'block'})],
+})
+const sourceId = string('legacyId', 'Existing app ID')
+const versionFields = [sourceId, string('versionId', 'Version ID'), date('generatedAt', 'Generated at'),
+  string('model', 'Generation model'), text('versionInstructions', 'Instructions for this version')]
+
+export const source = defineType({
+  name: 'source', title: 'Research source', type: 'object', icon: LinkIcon,
+  fields: [string('title', 'Title', true), defineField({name: 'url', title: 'URL', type: 'url',
+    validation: (rule) => rule.required().uri({scheme: ['https', 'http']})}),
+    string('publishedAt', 'Publication date as reported'), date('retrievedAt', 'Retrieved at')],
+  preview: {select: {title: 'title', subtitle: 'url'}},
+})
+export const evidencePoint = defineType({
+  name: 'evidencePoint', title: 'Evidence point', type: 'object', icon: DocumentTextIcon,
+  fields: [text('text', 'Text', true), string('sourceKey', 'Source key'),
+    defineField({name: 'basis', title: 'Evidence basis', type: 'string', options: {list: [
+      {title: 'Research source', value: 'research'}, {title: 'Job posting', value: 'posting'},
+      {title: 'Judgement / unverified', value: 'judgement'}]}})],
+  preview: {select: {title: 'text'}},
+})
+const points = (name: string, title: string) => defineField({
+  name, title, type: 'array', of: [defineArrayMember({type: 'evidencePoint'})],
+})
+const sources = defineField({name: 'sources', title: 'Sources', type: 'array',
+  of: [defineArrayMember({type: 'source'})]})
+
+export const candidateProfile = defineType({
+  name: 'candidateProfile', title: 'Candidate profile', type: 'document', icon: UserIcon,
+  fields: [string('name', 'Name', true), string('headline', 'Professional headline'),
+    body('summary', 'Candidate summary'), body('motivationSummary', 'Summary for motivation answers'),
+    body('interviewSummary', 'Summary for interview preparation'),
+    string('location', 'Location'), string('availability', 'Availability'),
+    text('workEligibility', 'Work eligibility and sponsorship'), string('noticePeriod', 'Notice period'),
+    text('careerDirection', 'Career direction'), text('workingPreferences', 'Working and travel preferences'),
+    text('salaryPreferences', 'Salary preferences'), text('constraints', 'Non-negotiable constraints'),
+    refs('evidence', 'Supporting evidence', 'candidateEvidence'),
+    defineField({name: 'confirmedAnswers', title: 'Confirmed factual answers', type: 'array', of: [
+      defineArrayMember({name: 'confirmedAnswer', title: 'Confirmed answer', type: 'object',
+        fields: [string('question', 'Exact question', true), text('answer', 'Confirmed answer', true)]}),
+    ]}), date('reviewedAt', 'Last reviewed')],
+  preview: {select: {title: 'name', subtitle: 'headline'}},
+})
+export const candidateEvidence = defineType({
+  name: 'candidateEvidence', title: 'Candidate evidence', type: 'document', icon: DocumentTextIcon,
+  fields: [string('title', 'Title', true), defineField({name: 'kind', title: 'Kind', type: 'string',
+    options: {list: ['employment', 'achievement', 'project', 'education', 'skill', 'preference', 'fact']},
+    validation: (rule) => rule.required()}), string('organisation', 'Organisation'),
+    string('period', 'Period'), body(), sources, date('reviewedAt', 'Last reviewed')],
+  preview: {select: {title: 'title', subtitle: 'organisation'}},
+})
+export const job = defineType({
+  name: 'job', title: 'Job opportunity', type: 'document', icon: DocumentTextIcon,
+  fields: [sourceId, string('company', 'Company', true), string('role', 'Role', true),
+    text('jobDescription', 'Original job description'), string('location', 'Location'),
+    string('locationMode', 'Working arrangement'), string('salary', 'Advertised salary'),
+    string('source', 'Source'), string('sourceType', 'Source type'),
+    defineField({name: 'sourceUrl', title: 'Posting URL', type: 'url'}),
+    string('externalId', 'External source ID'), string('threadId', 'Source conversation ID'),
+    defineField({name: 'stage', title: 'Application stage', type: 'string', initialValue: 'new',
+      options: {list: ['new', 'reviewing', 'applied', 'interviewing', 'offer', 'rejected', 'not_interested', 'expired']}}),
+    defineField({name: 'archived', title: 'Archived', type: 'boolean', initialValue: false}),
+    date('archivedAt', 'Archived at'), text('notes', 'Private notes'), text('instructions', 'Candidate instructions'),
+    defineField({name: 'recruiter', title: 'Recruiter', type: 'object', fields: [
+      string('name', 'Name'), string('email', 'Email'), string('phone', 'Phone'), string('company', 'Agency'),
+    ]}),
+    text('rationale', 'Initial fit rationale'), text('overviewSummary', 'Pipeline summary'),
+    ref('candidate', 'Candidate', 'candidateProfile'),
+    ref('activeReport', 'Active fit report', 'fitReport'), ref('activeCoverLetter', 'Active cover letter', 'coverLetter'),
+    ref('activeResearch', 'Active company research', 'companyResearch'),
+    ref('activeBrief', 'Active interview brief', 'interviewBrief'),
+    ref('activeAssessment', 'Active fit assessment', 'fitAssessment'),
+    date('receivedAt', 'Received at'), date('createdAt', 'Created in app')],
+  preview: {select: {title: 'role', subtitle: 'company'}},
+})
+export const applicationQuestion = defineType({
+  name: 'applicationQuestion', title: 'Application question and answer', type: 'document', icon: DocumentTextIcon,
+  fields: [sourceId, ref('job', 'Job', 'job', true), text('question', 'Question', true), text('answer', 'Answer'),
+    defineField({name: 'wordLimit', title: 'Word limit', type: 'number', initialValue: 120,
+      validation: (rule) => rule.integer().min(20).max(500)}),
+    defineField({name: 'refused', title: 'Needs a personal answer', type: 'boolean', initialValue: false}),
+    text('reason', 'Reason an answer could not be generated'), date('answeredAt', 'Answered at'),
+    defineField({name: 'order', title: 'Question order', type: 'number', validation: (rule) => rule.integer().min(0)})],
+  preview: {select: {title: 'question', subtitle: 'job.company'}},
+})
+export const fitReport = defineType({
+  name: 'fitReport', title: 'Fit report version', type: 'document', icon: DocumentTextIcon,
+  fields: [...versionFields, ref('job', 'Job', 'job'), string('jobTitle', 'Job title', true),
+    string('company', 'Company'), text('jobDescription', 'Job description used'), text('pitch', 'Opening pitch'),
+    defineField({name: 'categories', title: 'Fit categories', type: 'array', of: [defineArrayMember({
+      name: 'fitCategory', type: 'object', fields: [string('name', 'Category', true), text('note', 'Evidence')],
+    })]}),
+    defineField({name: 'differentiators', title: 'Differentiators', type: 'array', of: [defineArrayMember({
+      name: 'differentiator', type: 'object', fields: [string('headline', 'Headline', true), text('detail', 'Detail')],
+    })]}), text('closing', 'Closing'), text('privateReasoning', 'Private assessment reasoning'),
+    defineField({name: 'publiclyShared', title: 'May be served through a public app link', type: 'boolean', initialValue: false})],
+  preview: {select: {title: 'jobTitle', subtitle: 'company'}},
+})
+export const coverLetter = defineType({
+  name: 'coverLetter', title: 'Cover letter version', type: 'document', icon: DocumentTextIcon,
+  fields: [...versionFields, ref('job', 'Job', 'job', true), string('salutation', 'Salutation'), body(),
+    defineField({name: 'wordCount', title: 'Word count', type: 'number', readOnly: true})],
+  preview: {select: {title: 'job.role', subtitle: 'job.company'}},
+})
+export const companyResearch = defineType({
+  name: 'companyResearch', title: 'Company research version', type: 'document', icon: DocumentTextIcon,
+  fields: [...versionFields, ref('job', 'Job', 'job', true), string('company', 'Company', true),
+    string('domain', 'Company domain'), points('summary', 'Summary'), points('signals', 'Signals'),
+    points('risks', 'Risks'), points('roleContext', 'Role context'), text('unknowns', 'Unknowns'), sources,
+    defineField({name: 'partial', title: 'Incomplete research', type: 'boolean', initialValue: false})],
+  preview: {select: {title: 'company', subtitle: 'generatedAt'}},
+})
+export const interviewBrief = defineType({
+  name: 'interviewBrief', title: 'Interview brief version', type: 'document', icon: DocumentTextIcon,
+  fields: [...versionFields, ref('job', 'Job', 'job', true), ref('research', 'Research used', 'companyResearch'),
+    string('contact', 'Interview contact'), text('opening', 'Opening'), points('why', 'Why this role'),
+    text('conversationNotes', 'Conversation notes'), points('conversation', 'Conversation points'),
+    points('likelyQuestions', 'Likely questions'), points('gapResponses', 'Gap responses'),
+    points('greenFlags', 'Green flags'), points('redFlags', 'Red flags'), points('questionsToAsk', 'Questions to ask'),
+    points('companyReference', 'Company reference'), points('roleReference', 'Role reference'),
+    text('personalAnswers', 'Personal facts used'), text('confirmedAnswers', 'Confirmed answers used'),
+    text('unknowns', 'Unknowns'), sources],
+  preview: {select: {title: 'job.role', subtitle: 'job.company'}},
+})
+export const fitAssessment = defineType({
+  name: 'fitAssessment', title: 'Fit assessment', type: 'document', icon: DocumentTextIcon,
+  fields: [...versionFields, ref('job', 'Job', 'job', true),
+    defineField({name: 'score', title: 'Overall score', type: 'number', validation: (rule) => rule.min(0).max(100)}),
+    defineField({name: 'dimensions', title: 'Dimensions', type: 'array', of: [defineArrayMember({
+      name: 'assessmentDimension', type: 'object', fields: [string('name', 'Dimension', true),
+        defineField({name: 'score', title: 'Score', type: 'number', validation: (rule) => rule.min(0).max(100)}),
+        text('reasoning', 'Reasoning'), text('uncertainty', 'Uncertainty')],
+    })]}), text('reasoning', 'Reasoning'), text('clarifications', 'Clarifications'),
+    string('inputFingerprint', 'Input fingerprint'), string('policyVersion', 'Assessment policy version')],
+  preview: {select: {title: 'job.role', subtitle: 'job.company'}},
+})
+export const sitePage = defineType({
+  name: 'sitePage', title: 'Site page / CV', type: 'document', icon: DocumentTextIcon,
+  fields: [string('title', 'Title', true), defineField({name: 'slug', title: 'Slug', type: 'slug',
+    options: {source: 'title'}, validation: (rule) => rule.required()}), string('description', 'Description'),
+    body(), ref('candidate', 'Candidate', 'candidateProfile')],
+  preview: {select: {title: 'title', subtitle: 'slug.current'}},
+})
+export const writingGuidance = defineType({
+  name: 'writingGuidance', title: 'Writing guidance', type: 'document', icon: DocumentTextIcon,
+  fields: [string('title', 'Title', true), defineField({name: 'scope', title: 'Used for', type: 'string',
+    options: {list: ['shared', 'analysis', 'cover', 'answer', 'research', 'brief', 'assessment']},
+    validation: (rule) => rule.required()}), body(), date('reviewedAt', 'Last reviewed')],
+  preview: {select: {title: 'title', subtitle: 'scope'}},
+})
+
+export const contentTypes = [source, evidencePoint, candidateProfile, candidateEvidence, job,
+  applicationQuestion, fitReport, coverLetter, companyResearch, interviewBrief, fitAssessment,
+  sitePage, writingGuidance, defineType(migrationRecord)].map(type => type.type !== 'document' || type.name === 'migrationRecord' ? type : ({...type,
+    fields: [...type.fields.map(f => replacements[type.name]?.[f.name] || f), ...(extraFields[type.name] || []), ...migrationFields],
+  }))

new file mode 100644
index 0000000..9f580ba
--- /dev/null
+++ b/schemaTypes/migrationFields.ts
@@ -0,0 +1,52 @@
+import {defineArrayMember, defineField} from 'sanity'
+
+const field = (name: string, type = 'string') => defineField({name, type})
+const strings = (name: string) => defineField({name, type: 'array', of: [{type: 'string'}]})
+const object = (name: string, fields: ReturnType<typeof defineField>[]) => defineField({name, type: 'object', fields})
+const probabilities = defineField({name: 'probabilities', type: 'array', of: [defineArrayMember({type: 'object', fields: [field('label'), field('value', 'number')]})]})
+const answers = (name: string) => defineField({name, type: 'array', of: [defineArrayMember({type: 'object', fields: [field('question', 'text'), field('answer', 'text'), field('answeredAt', 'datetime')]})]})
+const choice = (name: string) => object(name, [field('type'), field('choice'), field('confidence', 'number'), probabilities])
+
+export const migrationFields = [
+  defineField({name: 'migration', title: 'Import provenance', type: 'object', readOnly: true, fields: [
+    field('sourceKey'), field('sourceHash'), field('importHash'), field('snapshotAt', 'datetime'), strings('qualityIssues'),
+  ]}),
+  defineField({name: 'sourcePayload', title: 'Original source record (recovery copy)', type: 'text', readOnly: true,
+    description: 'Immutable source JSON for lossless migration verification. Edit the structured fields above; this is not the live content source.', hidden: true}),
+]
+
+export const extraFields: Record<string, ReturnType<typeof defineField>[]> = {
+  job: [field('replyOwed', 'boolean'), field('userViewed', 'boolean'), field('closed', 'boolean'),
+    field('score', 'number'), field('tier'), field('updatedAt', 'datetime'), field('sourceRevision', 'number')],
+  fitReport: [defineField({name: 'jobs', title: 'Linked jobs', type: 'array', of: [{type: 'reference', to: [{type: 'job'}]}]}),
+    field('active', 'boolean'), field('createdAt', 'datetime'), field('regeneratedAt', 'datetime'),
+    object('generation', [field('prompt'),field('instructions','text'),field('effort')]),
+    object('internalAssessment', [field('score','number'),field('tier'),field('reasoning','text'),
+      defineField({name:'breakdown',type:'array',of:[defineArrayMember({type:'object',fields:[field('label'),field('value','number')]})]})])],
+  interviewBrief: [field('company'), field('role'), field('stage'), field('conversationReceivedAt', 'datetime'), field('conversationUpdatedAt', 'datetime')],
+  sitePage: [defineField({name: 'download', title: 'Downloadable document', type: 'file'}), field('legacyPath')],
+}
+
+export const replacements: Record<string, Record<string, ReturnType<typeof defineField>>> = {
+  job: {
+    company: defineField({name:'company',type:'string',description:'May be unknown for recruiter postings; preserve that uncertainty.'}),
+    overviewSummary: object('overviewSummary', [field('position', 'text'), field('fit', 'text'), field('model'), field('policy'), field('fingerprint'), field('assessedAt', 'datetime'), field('generatedAt', 'datetime')]),
+    recruiter: object('recruiter', [field('name'), field('org'), field('company'), field('email'), field('phone'), field('daysWaiting', 'number'), field('receivedAt','datetime')]),
+  },
+  companyResearch: {unknowns: strings('unknowns')},
+  interviewBrief: {unknowns: strings('unknowns'), confirmedAnswers: answers('confirmedAnswers'),
+    personalAnswers: object('personalAnswers', ['advertisedSalary','personallyExpectedSalary','previouslyDiscussedSalary','availability','location','locationMode','noticePeriod','startDate','sponsorship'].map(name=>field(name,'text')))},
+  fitAssessment: {
+    dimensions: defineField({name: 'dimensions', type: 'array', of: [defineArrayMember({type: 'object', fields: [
+      field('id'), field('label'), field('weight', 'number'), field('score', 'number'), field('confidence', 'number'),
+      probabilities, field('evidenceProbability', 'number'), field('evidenceLimited', 'boolean'), field('evidenceNote', 'text'),
+    ]})]}),
+  },
+}
+extraFields.fitAssessment = [choice('posting'), choice('constraint'), field('blocked', 'boolean'), field('provisional', 'boolean'), field('status')]
+
+export const migrationRecord = {
+  name: 'migrationRecord', title: 'Recovered source content', type: 'document' as const, readOnly: true,
+  fields: [field('title'), field('kind'), field('payload', 'text'), ...migrationFields],
+  preview: {select: {title: 'title', subtitle: 'kind'}},
+}
diff --git a/scripts/import-content.mjs b/scripts/import-content.mjs
new file mode 100644
index 0000000..650c2c2
--- /dev/null
+++ b/scripts/import-content.mjs
@@ -0,0 +1,75 @@
+import {readFile, writeFile, mkdir} from 'node:fs/promises'
+import {getCliClient} from 'sanity/cli'
+import {payload, digest, assertUnedited} from '../../fit-app/migration/scripts/integrity.mjs'
+
+const root = new URL('../../fit-app/', import.meta.url)
+const client = getCliClient({apiVersion:'2026-09-22'}).withConfig({useCdn:false, perspective:'raw', maxRetries:0})
+if (client.config().projectId !== 'quli96gc' || client.config().dataset !== 'production') throw new Error('Wrong Sanity destination')
+const documents = JSON.parse(await readFile(new URL('migration/transformed/content.json',root),'utf8'))
+const report = JSON.parse(await readFile(new URL('migration/reports/transform.json',root),'utf8'))
+if (report.issues.length) throw new Error('Resolve transform issues before importing')
+await mkdir(new URL('migration/extracted/',root),{recursive:true})
+const before = await client.fetch('*[!(_id in path("_.**"))]')
+await writeFile(new URL(`migration/extracted/sanity-before-${Date.now()}.json`,root),JSON.stringify(before,null,2),{flag:'wx'})
+const settingsRevision = before.find(d=>d._id==='fit-analysis-settings')?._rev
+const existing = new Map(before.map(d=>[d._id,d]))
+const documentIds = new Set(documents.map(d=>d._id))
+for (const doc of documents) {
+  if(!doc._id.startsWith('fit-import-') || !doc.migration?.sourceKey || !doc.sourcePayload) throw new Error('Invalid import document')
+  if(existing.has(`drafts.${doc._id}`)) throw new Error(`Unpublished edits exist for ${doc.migration.sourceKey}`)
+  const current = existing.get(doc._id)
+  assertUnedited(current, doc)
+}
+// Assets are content addressed by Sanity; repeated uploads reuse the same asset.
+const cv = await client.assets.upload('file', await readFile(new URL('public/bernardo-raposo-cv.pdf',root)), {filename:'bernardo-raposo-cv.pdf',contentType:'application/pdf'})
+const cvDoc = documents.find(d=>d.migration.sourceKey==='page:cv')
+cvDoc.download = {_type:'file',asset:{_type:'reference',_ref:cv._id}}
+documentIds.add(cv._id)
+const checkRefs = value => {
+  if(!value || typeof value !== 'object') return
+  if(value._ref && !documentIds.has(value._ref)) throw new Error(`Missing reference target ${value._ref}`)
+  Object.values(value).forEach(checkRefs)
+}
+documents.forEach(checkRefs)
+const shells = documents.filter(d=>!existing.has(d._id)).map(d=>{
+  const shell = {_id:d._id,_type:d._type,migration:{sourceKey:d.migration.sourceKey},sourcePayload:'{}'}
+  shell.migration.importHash = digest(shell)
+  return shell
+})
+for(let offset=0;offset<shells.length;offset+=40) {
+  let tx=client.transaction()
+  shells.slice(offset,offset+40).forEach(d=>{tx=tx.createIfNotExists(d)})
+  await tx.commit({visibility:'sync'})
+}
+const readDocuments = async () => {
+  const result=[]
+  for(let offset=0;offset<documents.length;offset+=40) result.push(...await client.getDocuments(documents.slice(offset,offset+40).map(d=>d._id)))
+  return result
+}
+const currentDocuments = await readDocuments()
+let updated=0, unchanged=0
+for(let offset=0;offset<documents.length;offset+=20) {
+  let tx=client.transaction(), writes=0
+  for(let i=offset;i<Math.min(offset+20,documents.length);i++) {
+    const doc=documents[i], current=currentDocuments[i]
+    if(!current || current.migration?.importHash!==digest(current)) throw new Error('Destination edited during migration; stopping')
+    doc.migration.importHash=digest(doc)
+    if(digest(current)===doc.migration.importHash) {unchanged++;continue}
+    const {_id,...fields}=doc
+    // Revision guard prevents overwriting Studio edits made during this run.
+    const obsolete=Object.keys(payload(current)).filter(k=>k!=='_id' && !(k in fields))
+    tx=tx.patch(_id,p=>p.ifRevisionId(current._rev).set(fields).unset(obsolete))
+    writes++; updated++
+  }
+  if(writes) await tx.commit({visibility:'sync'})
+}
+const after = await readDocuments()
+const failures=[]
+for(let i=0;i<documents.length;i++) if(!after[i] || digest(after[i])!==digest(documents[i])) failures.push(documents[i].migration.sourceKey)
+const settings = await client.getDocument('fit-analysis-settings')
+if(settings?._rev!==settingsRevision) failures.push('Analysis settings changed during import; review concurrent edits')
+const result={verifiedAt:new Date().toISOString(),created:shells.length,updated,unchanged,total:documents.length,counts:report.counts,
+  exactContentMismatches:failures.length,failures,cvAsset:cv._id,analysisSettingsUnchanged:settings?._rev===settingsRevision,limitations:report.limitations}
+await writeFile(new URL('migration/reports/import.json',root),JSON.stringify(result,null,2))
+console.log(JSON.stringify(result,null,2))
+if(failures.length) process.exitCode=1

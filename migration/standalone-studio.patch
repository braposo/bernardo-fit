+import {getCliClient} from 'sanity/cli'
+import {initialSettingsDocument} from '../../fit-app/lib/sanity/settings-document.js'
+import {settingsFromDocument} from '../../fit-app/lib/sanity/analysis-settings.js'
+
+const client = getCliClient({apiVersion: '2026-09-22'}).withConfig({useCdn: false})
+const document = initialSettingsDocument()
+settingsFromDocument(document)
+const existing = await client.getDocument(document._id)
+if (existing) {
+  console.log('Analysis settings already exist; left published content unchanged.')
+} else {
+  await client.createIfNotExists(document)
+  console.log('Published the current code instructions as Analysis settings. No jobs or artifacts imported.')
+}
diff --git a/scripts/transform-content.mjs b/scripts/transform-content.mjs
new file mode 100644
index 0000000..f57931f
--- /dev/null
+++ b/scripts/transform-content.mjs
@@ -0,0 +1,188 @@
+import {readFile, writeFile, mkdir} from 'node:fs/promises'
+import {createHash} from 'node:crypto'
+import {Schema} from '@sanity/schema'
+import {htmlToBlocks} from '@portabletext/block-tools'
+import {markdownToPortableText} from '@portabletext/markdown'
+import {JSDOM} from 'jsdom'
+import {DEFAULT_SETTINGS} from '../../fit-app/lib/sanity/analysis-defaults.js'
+
+const root = new URL('../../fit-app/', import.meta.url)
+const read = async path => JSON.parse(await readFile(new URL(path, root), 'utf8'))
+const snapshot = await read('migration/extracted/admin-export.json')
+const artifactExport = await read('migration/extracted/admin-artifacts.json')
+const docs = new Map(), issues = []
+const hash = value => createHash('sha256').update(typeof value === 'string' ? value : JSON.stringify(value)).digest('hex')
+const id = key => `fit-import-${hash(key).slice(0, 40)}`
+const reference = key => ({_type: 'reference', _ref: id(key)})
+const clean = value => {
+  if (Array.isArray(value)) return value.map(clean)
+  if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value)
+    .filter(([,v]) => v !== undefined && v !== null && v !== '').map(([k,v]) => [k, clean(v)]))
+  return value
+}
+const keyed = values => (values || []).map((v,i) => ({_key: `item${i}`, ...v}))
+const pick = (value, fields) => Object.fromEntries(fields.split(' ').filter(k => value[k] !== undefined).map(k => [k,value[k]]))
+const add = (key, type, source, fields) => {
+  const document = clean({_id: id(key), _type: type, ...fields,
+    migration: {sourceKey: key, sourceHash: hash(source), snapshotAt: snapshot.exportedAt}, sourcePayload: JSON.stringify(source)})
+  if (docs.has(key)) throw new Error(`Duplicate source identity: ${key}`)
+  docs.set(key, document)
+  return reference(key)
+}
+const schema = Schema.compile({name: 'migration', types: [{name: 'richText', type: 'array', of: [{type: 'block'}]}]})
+const html = input => {
+  let index = 0
+  return htmlToBlocks(input, schema.get('richText'), {parseHtml: s => new JSDOM(s).window.document, keyGenerator: () => `html${index++}`})
+}
+const markdown = input => {
+  const blocks = markdownToPortableText(input)
+  // Converter keys are random; remap keys and mark references deterministically.
+  let sequence = 0
+  const keys = new Map()
+  const visit = value => {
+    if (Array.isArray(value)) return value.forEach(visit)
+    if (!value || typeof value !== 'object') return
+    if (value._key) {const old = value._key; value._key = `md${sequence++}`; keys.set(old, value._key)}
+    Object.values(value).forEach(visit)
+  }
+  visit(blocks)
+  for (const b of blocks) for (const s of b.children || []) if (s.marks) s.marks = s.marks.map(k => keys.get(k) || k)
+  return blocks
+}
+const escape = value => String(value || '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
+const coverBody = paragraphs => html(paragraphs.map(p => {
+  if (typeof p === 'string') return `<p>${escape(p)}</p>`
+  const text = p.html ?? escape(p.text || '').replace(/\[\[([\s\S]*?)\]\]/g, '<strong>$1</strong>')
+  return `<p>${p.lead ? `<strong>${escape(p.lead)}</strong> ` : ''}${text}</p>`
+}).join(''))
+const probabilities = value => keyed(Object.entries(value || {}).map(([label, value]) => ({label, value})))
+const candidate = add('candidate:bernardo', 'candidateProfile', DEFAULT_SETTINGS, {
+  name: 'Bernardo Raposo', summary: markdown(DEFAULT_SETTINGS.texts.candidateProfile),
+  motivationSummary: markdown(DEFAULT_SETTINGS.texts.motivationProfile), interviewSummary: markdown(DEFAULT_SETTINGS.texts.interviewProfile),
+  location: DEFAULT_SETTINGS.personalFacts.location, availability: DEFAULT_SETTINGS.personalFacts.availability,
+  workEligibility: DEFAULT_SETTINGS.personalFacts.sponsorship, confirmedAnswers: keyed(DEFAULT_SETTINGS.facts),
+})
+const evidence = DEFAULT_SETTINGS.texts.candidateProfile.split(/(?=^## )/m).filter(s=>s.trim())
+docs.get('candidate:bernardo').evidence = evidence.map((body,i) => add(`candidate:evidence:${i}`, 'candidateEvidence', body, {
+  title: body.match(/^#+ (.+)$/m)?.[1] || `Candidate evidence ${i + 1}`, kind: 'fact', body: markdown(body),
+}))
+
+for (const job of snapshot.jobs) {
+  add(`job:${job.id}`, 'job', job, {...pick(job, 'company role jobDescription location locationMode salary source sourceType sourceUrl externalId threadId stage archived archivedAt notes instructions recruiter rationale overviewSummary replyOwed userViewed closed score tier receivedAt createdAt updatedAt'),
+    legacyId: job.id, sourceRevision: job.revision, candidate, stage: job.stage === 'not_a_fit' ? 'not_interested' : job.stage,
+  })
+  if (!job.company) docs.get(`job:${job.id}`).migration.qualityIssues = ['Company is missing in the source posting']
+  for (const [index, q] of (job.questions || []).entries()) add(`question:${job.id}:${q.id}`, 'applicationQuestion', q, {
+    legacyId: q.id, job: reference(`job:${job.id}`), question: q.q, answer: q.a, wordLimit: q.limit,
+    refused: q.refused, reason: q.reason, answeredAt: q.answeredAt, order: index,
+  })
+  if (job.jevAssessment) {
+    const a = job.jevAssessment
+    const choice = v => v ? {...v, probabilities: probabilities(v.probabilities)} : undefined
+    docs.get(`job:${job.id}`).activeAssessment = add(`assessment:${job.id}:${a.fingerprint}`, 'fitAssessment', a, {
+      job: reference(`job:${job.id}`), legacyId: job.id, ...pick(a, 'score model blocked provisional status'),
+      generatedAt: a.assessedAt, inputFingerprint: a.fingerprint, policyVersion: a.policy,
+      dimensions: keyed(a.dimensions.map(d => ({...d, probabilities: probabilities(d.probabilities)}))),
+      posting: choice(a.posting), constraint: choice(a.constraint),
+    })
+  }
+}
+for (const report of snapshot.reports) {
+  const jobs = snapshot.jobs.filter(j=>j.fitReportId===report.id).map(j=>reference(`job:${j.id}`))
+  const fields = r => ({legacyId: report.id, jobs, job: jobs[0], jobTitle: r.job_title, company: r.company,
+    jobDescription: r.job_description, pitch: r.pitch, categories: keyed(r.categories), differentiators: keyed(r.differentiators),
+    closing: r.closing, model: r.model, generatedAt: r.regenerated_at || r.created_at, createdAt: r.created_at, regeneratedAt: r.regenerated_at,
+    generation: r.generation, publiclyShared: true})
+  add(`report:${report.id}:current`, 'fitReport', report, {...fields(report), active: true})
+  for (const v of snapshot.versions[report.id] || []) add(`report:${report.id}:${v.vid}`, 'fitReport', v, {
+    ...fields(v.report), versionId: v.vid, generatedAt: v.createdAt, model: v.model, versionInstructions: v.versionInstructions,
+    active: false, privateReasoning: v.internal?.reasoning,
+    internalAssessment:v.internal ? {...v.internal,breakdown:probabilities(v.internal.breakdown)} : undefined,
+  })
+}
+const covers = new Map()
+for (const job of snapshot.jobs) {
+  for (const v of job.coverLetterVersions || []) covers.set(`${job.id}:${v.vid}`, {jobId: job.id, ...v})
+  if (job.coverLetter?.length) {
+    const matched = [...covers.values()].find(v=>v.jobId===job.id && JSON.stringify(v.paragraphs)===JSON.stringify(job.coverLetter))
+    const vid = matched?.vid || `legacy${hash(job.coverLetter).slice(0,16)}`
+    if (!matched) covers.set(`${job.id}:${vid}`, {jobId: job.id, vid, at: job.coverLetterAt, model: job.coverLetterModel,
+      salutation: job.coverLetterSalutation, words: job.coverLetterWords, paragraphs: job.coverLetter})
+    docs.get(`job:${job.id}`).activeCoverLetter = reference(`cover:${job.id}:${job.coverLetterId || vid}`)
+  }
+}
+const points = values => keyed((values || []).map(v => typeof v === 'string' ? {text:v, basis:'judgement'} : {
+  text: v.text, sourceKey: typeof v.src === 'number' ? String(v.src) : undefined,
+  basis: v.src === 'posting' ? 'posting' : typeof v.src === 'number' ? 'research' : 'judgement',
+}))
+for (const a of artifactExport.artifacts) {
+  if (a.kind === 'letter') {covers.set(`${a.jobId}:${a.vid}`, {...covers.get(`${a.jobId}:${a.vid}`), ...a}); continue}
+  const job = snapshot.jobs.find(j=>j.id===a.jobId)
+  const common = {job: reference(`job:${a.jobId}`), legacyId:a.jobId, versionId:a.vid, generatedAt:a.at || job[`${a.kind}At`],
+    model:a.model || job[`${a.kind}Model`], sources:(a.sources || []).map((s,i)=>({_key:String(s.id ?? i), _type:'source', ...pick(s,'title url retrievedAt publishedAt')})), unknowns:a.unknowns}
+  if (a.kind === 'research') add(`research:${a.jobId}:${a.vid}`, 'companyResearch', a, {...common,company:job.company,domain:a.domain,partial:a.partial ?? job.researchPartial,
+    ...Object.fromEntries(['summary','signals','risks','roleContext'].map(k=>[k,points(a[k])]))})
+  else add(`brief:${a.jobId}:${a.vid}`, 'interviewBrief', a, {...common,company:job.company,role:job.role,stage:job.briefStage,
+    contact:a.contact,opening:a.opening,personalAnswers:a.personalAnswers,confirmedAnswers:keyed(a.confirmedAnswers),
+    conversationNotes:a.conversation?.notes,conversationReceivedAt:a.conversation?.receivedAt,conversationUpdatedAt:a.conversation?.updatedAt,
+    conversation:points(a.conversation?.points), ...Object.fromEntries(['why','likelyQuestions','gapResponses','greenFlags','redFlags','questionsToAsk','companyReference','roleReference'].map(k=>[k,points(a[k])]))})
+}
+for (const [key,a] of covers) add(`cover:${key}`, 'coverLetter', a, {
+  job:reference(`job:${a.jobId}`), legacyId:a.jobId, versionId:a.vid, generatedAt:a.at,model:a.model,versionInstructions:a.versionInstructions,
+  salutation:a.salutation,wordCount:a.words,body:coverBody(a.paragraphs || []),
+})
+for (const job of snapshot.jobs) {
+  const doc = docs.get(`job:${job.id}`)
+  for (const [field,key] of [['activeReport',job.fitReportId && `report:${job.fitReportId}:current`],
+    ['activeCoverLetter',job.coverLetterId && `cover:${job.id}:${job.coverLetterId}`],
+    ['activeResearch',job.researchId && `research:${job.id}:${job.researchId}`], ['activeBrief',job.briefId && `brief:${job.id}:${job.briefId}`]]) {
+    if (!key) continue
+    if (docs.has(key)) doc[field] = reference(key)
+    else issues.push({sourceKey:`job:${job.id}`,missingReference:key})
+  }
+}
+const cvSource = await readFile(new URL('public/cv.html',root),'utf8')
+const cvDom = new JSDOM(cvSource).window.document
+cvDom.querySelectorAll('script,style,nav,button').forEach(el=>el.remove())
+add('page:cv', 'sitePage', cvSource, {title:'Bernardo Raposo · CV',slug:{_type:'slug',current:'cv'},legacyPath:'/cv.html',candidate,body:html(cvDom.body.innerHTML)})
+// Render only the trusted repository's inline homepage script in an offline DOM.
+// No external resources are enabled, and network access is explicitly disabled.
+const homeSource=await readFile(new URL('public/index.html',root),'utf8')
+const homeDom=new JSDOM(homeSource,{url:'https://fit.bernardoraposo.com/',runScripts:'outside-only'})
+homeDom.window.fetch=()=>{throw new Error('Network is disabled during source conversion')}
+const homeScript=homeDom.window.document.querySelector('script').textContent
+if(!homeScript.includes('var params = new URLSearchParams(location.search);')) throw new Error('Homepage structure changed; review converter')
+homeDom.window.eval(homeScript.replace('var params = new URLSearchParams(location.search);','window.__migrationDemo = DEMO_REPORT; var params = new URLSearchParams(location.search);'))
+add('page:home','sitePage',homeSource,{title:'Fit home',slug:{_type:'slug',current:'home'},legacyPath:'/',candidate,
+  body:html(homeDom.window.document.getElementById('app').innerHTML)})
+const demo=JSON.parse(JSON.stringify(homeDom.window.__migrationDemo))
+add('report:demo','fitReport',demo,{legacyId:'demo',jobTitle:demo.job_title,company:demo.company,pitch:demo.pitch,
+  categories:keyed(demo.categories),differentiators:keyed(demo.differentiators),closing:demo.closing,publiclyShared:false,active:false})
+homeDom.window.close()
+const ids = new Set([...docs.values()].map(d=>d._id))
+const validate = (value, sourceKey) => {
+  if (!value || typeof value !== 'object') return
+  if (value._ref && !ids.has(value._ref)) issues.push({sourceKey, danglingReference:value._ref})
+  if (Array.isArray(value)) {
+    const objects = value.filter(v=>v && typeof v==='object')
+    if (objects.some(v=>!v._key)) issues.push({sourceKey, missingArrayKey:true})
+  }
+  for (const child of Object.values(value)) validate(child,sourceKey)
+}
+// Reference arrays also require keys in Studio.
+for (const doc of docs.values()) {
+  const keys = value => {
+    if (Array.isArray(value)) value.forEach((v,i)=>{if(v && typeof v==='object') v._key ||= `item${i}`; keys(v)})
+    else if(value && typeof value==='object') Object.values(value).forEach(keys)
+  }
+  keys(doc); validate(doc,doc.migration.sourceKey)
+}
+await mkdir(new URL('migration/transformed/',root),{recursive:true})
+await mkdir(new URL('migration/reports/',root),{recursive:true})
+await writeFile(new URL('migration/transformed/content.json',root),JSON.stringify([...docs.values()].map(clean),null,2))
+await writeFile(new URL('migration/transformed/content.ndjson',root),[...docs.values()].map(d=>JSON.stringify(clean(d))).join('\n')+'\n')
+const report = {snapshotAt:snapshot.exportedAt,counts:Object.fromEntries([...new Set([...docs.values()].map(d=>d._type))].map(t=>[t,[...docs.values()].filter(d=>d._type===t).length])),issues,
+  limitations:['Admin export cannot prove orphan coverage or recover trimmed histories. Raw KV scan required.', 'Artifact preview API omits some generation provenance and brief confirmed answers.', 'Dynamic UI labels, loading/error messages and admin interface copy still live in application code; homepage body and demo report are imported.', 'App remains on Redis; rerun latest source delta before cutover.']}
+await writeFile(new URL('migration/reports/transform.json',root),JSON.stringify(report,null,2))
+console.log(JSON.stringify(report,null,2))
+if(issues.length) process.exitCode=1

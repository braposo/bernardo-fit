+import {defineArrayMember, defineField, defineType} from 'sanity'
+import {CogIcon} from '@sanity/icons/Cog'
+
+const requiredText = (name: string, title: string, rows = 6) => defineField({
+  name, title, type: 'text', rows, validation: (rule) => rule.required().max(80000),
+})
+const key = (name = 'key') => defineField({name, title: 'App key', type: 'string', readOnly: true,
+  validation: (rule) => rule.required()})
+
+export const analysisSettings = defineType({
+  name: 'analysisSettings', title: 'Analysis settings', type: 'document', icon: CogIcon,
+  groups: [{name: 'prompts', title: 'Prompts and candidate context', default: true},
+    {name: 'jev', title: 'Jev rubric and routing'}, {name: 'facts', title: 'Confirmed facts'}],
+  fields: [
+    defineField({name: 'title', title: 'Title', type: 'string', initialValue: 'Fit analysis settings'}),
+    defineField({name: 'texts', title: 'Prompts and candidate context', group: 'prompts', type: 'array',
+      description: 'Published changes are read by new analysis tasks. Keep {{placeholder}} names unchanged. Output format requirements must match the app. All 13 entries are required.',
+      validation: (rule) => rule.required().length(13),
+      of: [defineArrayMember({name: 'promptText', title: 'Prompt or context', type: 'object',
+        fields: [key(), defineField({name: 'title', title: 'Label', type: 'string', readOnly: true}), requiredText('text', 'Text', 20)],
+        preview: {select: {title: 'title', subtitle: 'key'}},
+      })]}),
+    defineField({name: 'questions', title: 'Jev instructions and criteria', group: 'jev', type: 'array',
+      description: 'Includes all five fit dimensions, evidence checks, posting/constraint checks, and the two routing decisions. Keys and answer types are app contracts.',
+      validation: (rule) => rule.required().length(14),
+      of: [defineArrayMember({name: 'jevQuestion', title: 'Jev question', type: 'object', fields: [key(),
+        defineField({name: 'type', title: 'Answer type', type: 'string', readOnly: true}),
+        requiredText('instructions', 'Instructions', 12),
+        defineField({name: 'criteria', title: 'Rating levels (lowest to highest)', type: 'array',
+          hidden: ({parent}) => parent?.type !== 'score', of: [defineArrayMember({type: 'string'})],
+          validation: (rule) => rule.custom((value, context) => (context.parent as {type?: string})?.type !== 'score'
+            || (Array.isArray(value) && value.length === 5 && value.every(v => typeof v === 'string' && v.trim()))
+            || 'Keep five non-empty levels, from 0 to 4.')}),
+        defineField({name: 'options', title: 'Choice criteria', type: 'array', hidden: ({parent}) => parent?.type !== 'choice',
+          of: [defineArrayMember({name: 'jevOption', type: 'object', fields: [key(), requiredText('text', 'Description')],
+            preview: {select: {title: 'key', subtitle: 'text'}}})]}),
+      ], preview: {select: {title: 'key', subtitle: 'type'}}})]}),
+    defineField({name: 'dimensions', title: 'Fit dimensions', group: 'jev', type: 'array',
+      description: 'Weights must sum to 100. Score calibration and probability thresholds remain validated application logic.',
+      validation: (rule) => rule.required().length(5).custom((value) => !value || value.reduce<number>((sum, item) =>
+        sum + Number((item as {weight?: number}).weight || 0), 0) === 100 || 'Weights must total 100.'),
+      of: [defineArrayMember({name: 'fitDimension', type: 'object', fields: [key('id'),
+        defineField({name: 'label', title: 'Label', type: 'string', validation: (rule) => rule.required()}),
+        defineField({name: 'weight', title: 'Weight', type: 'number', validation: (rule) => rule.required().integer().min(0).max(100)}),
+        requiredText('gap', 'Message when evidence is limited')], preview: {select: {title: 'label', subtitle: 'id'}}})]}),
+    defineField({name: 'facts', title: 'Exact factual answers', group: 'facts', type: 'array',
+      description: 'These answers can bypass a model call when the exact question matches and economy mode is enabled.',
+      of: [defineArrayMember({name: 'factualAnswer', type: 'object', fields: [requiredText('question', 'Question', 2),
+        requiredText('answer', 'Confirmed answer')], preview: {select: {title: 'question', subtitle: 'answer'}}})]}),
+    defineField({name: 'routineQuestions', title: 'Routine motivation questions', group: 'facts', type: 'array',
+      of: [defineArrayMember({type: 'string'})], validation: (rule) => rule.unique()}),
+    defineField({name: 'personalFacts', title: 'Interview personal facts', group: 'facts', type: 'object', fields: [
+      requiredText('availability', 'Availability', 2), requiredText('location', 'Location', 2),
+      requiredText('sponsorship', 'Work eligibility / sponsorship', 2),
+    ]}),
+  ],
+  preview: {prepare: () => ({title: 'Analysis settings', subtitle: 'Publish to apply to new tasks'})},
+})

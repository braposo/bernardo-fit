+import {defineField as field} from 'sanity'
+const text = (name: string, title: string) => field({name, title, type: 'string'})
+const rich = (name: string, title: string) =>
+  field({name, title, type: 'array', of: [{type: 'block'}]})
+const contacts = field({
+  name: 'contacts',
+  title: 'Contact details',
+  type: 'array',
+  of: [
+    {
+      type: 'object',
+      fields: [
+        text('label', 'Label'),
+        field({
+          name: 'href',
+          title: 'Link',
+          type: 'url',
+          validation: (r) => r.uri({scheme: ['https', 'http', 'mailto']}),
+        }),
+      ],
+      preview: {select: {title: 'label'}},
+    },
+  ],
+})
+export const publicPageFields = [
+  field({
+    name: 'home',
+    title: 'Homepage',
+    type: 'object',
+    hidden: ({document}) => (document?.slug as {current?: string} | undefined)?.current !== 'home',
+    fields: [
+      text('name', 'Name'),
+      rich('heading', 'Heading'),
+      rich('introduction', 'Introduction'),
+      text('buttonLabel', 'Submit button'),
+      text('placeholder', 'Posting placeholder'),
+      text('hint', 'Generation hint'),
+      contacts,
+    ],
+  }),
+  field({
+    name: 'cv',
+    title: 'CV layout',
+    type: 'object',
+    hidden: ({document}) => (document?.slug as {current?: string} | undefined)?.current !== 'cv',
+    fields: [
+      text('name', 'Name'),
+      text('headline', 'Headline'),
+      contacts,
+      field({
+        name: 'sections',
+        title: 'Sections',
+        type: 'array',
+        of: [
+          {
+            type: 'object',
+            fields: [
+              text('label', 'Section label'),
+              field({
+                name: 'items',
+                title: 'Content',
+                type: 'array',
+                of: [
+                  {
+                    type: 'object',
+                    fields: [
+                      field({
+                        name: 'kind',
+                        title: 'Layout',
+                        type: 'string',
+                        options: {list: ['text', 'role', 'skill']},
+                      }),
+                      text('title', 'Role or skill'),
+                      text('dates', 'Dates'),
+                      text('location', 'Location'),
+                      rich('body', 'Content'),
+                    ],
+                    preview: {select: {title: 'title', subtitle: 'kind'}},
+                  },
+                ],
+              }),
+            ],
+            preview: {select: {title: 'label'}},
+          },
+        ],
+      }),
+    ],
+  }),
+]

{
  "name": "bernardo-fit",
  "version": "1.0.0",
  "description": "A first-person job-fit tool for Bernardo Raposo — paste a role, get an honest read, share a permalink.",
  "type": "module",
  "private": true,
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.62",
    "@ai-sdk/mcp": "2.0.57",
    "@ai-sdk/openai": "4.0.74",
    "@sanity/client": "^8.6.2",
    "@shadcn/react": "^0.3.1",
    "@trigger.dev/react-hooks": "^4.5.16",
    "@trigger.dev/sdk": "4.5.16",
    "@vercel/kv": "^2.0.0",
    "ai": "7.0.113",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "groq": "^6.16.0",
    "html-react-parser": "^6.1.8",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "test:chat-ui": "node scripts/verify-chat-ui.mjs",
    "chat:evaluate": "node --env-file-if-exists=.env.development.local scripts/evaluate-chat.mjs",
    "chat:check": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local --env-file-if-exists=.env.context.local scripts/check-chat.mjs",
    "jev:check": "node --env-file-if-exists=.env.local scripts/check-jev.mjs",
    "build": "node scripts/build-admin.mjs",
    "test:admin-ui": "node scripts/verify-admin-ux.mjs",
    "test": "node tests/run.mjs",
    "trigger:dev": "trigger dev --skip-update-check",
    "trigger:dev:sanity": "node scripts/start-sanity-worker.mjs",
    "trigger:check": "trigger deploy --dry-run --skip-update-check",
    "trigger:deploy": "trigger deploy --skip-update-check",
    "trigger:health": "trigger report health --env prod --period 24h",
    "sanity:check": "node --env-file-if-exists=.env.local scripts/check-sanity.mjs",
    "sanity:storage:check": "node --env-file-if-exists=.env.local scripts/check-sanity-storage.mjs",
    "sanity:settings:check": "node --env-file-if-exists=.env.local scripts/check-analysis-settings.mjs",
    "test:task-ui": "node scripts/verify-task-toasts.mjs",
    "trigger:dev:chat": "node scripts/start-chat-worker.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@sanity/blueprints": "0.27.0",
    "@tailwindcss/cli": "^4.3.3",
    "@trigger.dev/build": "4.5.16",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "trigger.dev": "4.5.16",
    "tw-animate-css": "^1.4.0"
  }
}
